package = freetype

# static/linux
compilerOpts.linux = -I../.third-party/workspace/dist/x86_64-linux-gnu/freetype/include/freetype2
headers.linux = ft2build.h
libraryPaths.linux = ../.third-party/workspace/dist/x86_64-linux-gnu/freetype/lib
staticLibraries.linux = libfreetype.a

# static/mingw
compilerOpts.mingw = -I../.third-party/workspace/dist/x86_64-w64-mingw32/freetype/include/freetype2
headers.mingw = ft2build.h
libraryPaths.mingw = ../.third-party/workspace/dist/x86_64-w64-mingw32/freetype/lib
staticLibraries.mingw = libfreetype.a
