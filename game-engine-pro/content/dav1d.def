package = dav1d

# static/linux
compilerOpts.linux = -I../.third-party/workspace/dist/x86_64-linux-gnu/dav1d/include
headers.linux = dav1d/dav1d.h
libraryPaths.linux = ../.third-party/workspace/dist/x86_64-linux-gnu/dav1d/lib
staticLibraries.linux = libdav1d.a

# static/mingw
compilerOpts.mingw = -I../.third-party/workspace/dist/x86_64-w64-mingw32/dav1d/include
headers.mingw = dav1d/dav1d.h
libraryPaths.mingw = ../.third-party/workspace/dist/x86_64-w64-mingw32/dav1d/lib
staticLibraries.mingw = libdav1d.a
