package = opusfile

# static/linux
compilerOpts.linux = -I../.third-party/workspace/dist/x86_64-linux-gnu/ogg/include -I../.third-party/workspace/dist/x86_64-linux-gnu/opus/include/opus -I../.third-party/workspace/dist/x86_64-linux-gnu/opusfile/include
headers.linux = opus/opusfile.h
libraryPaths.linux = ../.third-party/workspace/dist/x86_64-linux-gnu/opusfile/lib
staticLibraries.linux = libopusfile.a

# static/mingw
compilerOpts.mingw = -I../.third-party/workspace/dist/x86_64-w64-mingw32/ogg/include -I../.third-party/workspace/dist/x86_64-w64-mingw32/opus/include/opus -I../.third-party/workspace/dist/x86_64-w64-mingw32/opusfile/include
headers.mingw = opus/opusfile.h
libraryPaths.mingw = ../.third-party/workspace/dist/x86_64-w64-mingw32/opusfile/lib
staticLibraries.mingw = libopusfile.a
