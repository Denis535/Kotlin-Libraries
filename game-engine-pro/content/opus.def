package = opus

# static/linux
compilerOpts.linux = -I../.third-party/workspace/dist/x86_64-linux-gnu/opus/include/opus
headers.linux = opus.h
libraryPaths.linux = ../.third-party/workspace/dist/x86_64-linux-gnu/opus/lib
staticLibraries.linux = libopus.a

# static/mingw
compilerOpts.mingw = -I../.third-party/workspace/dist/x86_64-w64-mingw32/opus/include/opus
headers.mingw = opus.h
libraryPaths.mingw = ../.third-party/workspace/dist/x86_64-w64-mingw32/opus/lib
staticLibraries.mingw = libopus.a
