prefix=/usr/src/mxe/usr/x86_64-w64-mingw32.static
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: harfbuzz
Description: HarfBuzz text shaping library
Version: 15.1.0

Libs: -L${libdir} -lharfbuzz
Libs.private: -lm -pthread
Requires.private: 
Cflags: -I${includedir}/harfbuzz
